# Database (required)
# PostgreSQL connection string. Get one from Vercel Postgres, Neon, Supabase, or run locally.
DATABASE_URL="postgresql://user:password@localhost:5432/subsave?schema=public"

# Clerk (required)
# Get keys from Clerk dashboard: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxx"

# Optional Clerk route overrides
# NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
# NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# AI assistant (required for chat)
GEMINI_API_KEY="your-gemini-api-key"
