# Database (required)
# PostgreSQL connection string. Get one from Vercel Postgres, Neon, Supabase, or run locally.
DATABASE_URL="postgresql://user:password@localhost:5432/subsave?schema=public"

# NextAuth (required for production)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional – set for "Sign in with Google")
# Create at https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Set to "true" to show Google sign-in button on the client
# NEXT_PUBLIC_GOOGLE_ENABLED=true

# Email sign-in (optional – set for magic link sign-in)
# EMAIL_SERVER_HOST=
# EMAIL_SERVER_PORT=
# EMAIL_SERVER_USER=
# EMAIL_SERVER_PASSWORD=
# EMAIL_FROM="SubSave <noreply@example.com>"

# Development
# With no Google/Email configured, in development you can sign in with any email (dev login).
